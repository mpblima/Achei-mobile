{
  "expo": {
    "name": "Achei",
    "slug": "achei-mobile",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/achei-icon.png",
    "scheme": "achei",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "tech.praesens.achei",
      "icon": "./assets/images/achei-icon.png"
    },
    "android": {
      "package": "tech.praesens.achei",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#4A1B0C",
        "foregroundImage": "./assets/images/achei-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/achei-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F6F1",
          "image": "./assets/images/achei-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Achei usa a câmera para fotografar itens.",
          "photosPermission": "O Achei acessa suas fotos para adicionar imagens aos itens e configurar sua imagem de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      "./plugins/withAndroidReleaseSigning",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3568011d-1a32-4980-9709-79af838b8a05"
      }
    },
    "owner": "mpblima"
  }
}
